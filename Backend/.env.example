# ==============================================================================
# Backend Environment Configuration (Node.js / Express)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env in local development: cp .env.example .env
# 2. In production on Hostinger:
#    - Enter these environment variables in the Hostinger Node.js Application Manager, OR
#    - Create a secure .env file in the backend application root directory on Hostinger.
# NEVER commit production passwords, connection strings, or JWT secrets to Git!
# ==============================================================================

# Server Configuration
# In production on Hostinger: Hostinger automatically assigns or expects PORT
PORT=4000
NODE_ENV=production

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string.
# Format: mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://db_username:db_password@cluster0.example.mongodb.net/Kent?retryWrites=true&w=majority

# JWT Authentication Secret Key
# Generate a strong, cryptographically secure 64-character string for production signing.
JWT_SECRET=replace_with_strong_production_jwt_secret_key_minimum_32_characters

# Production Frontend Allowed Origin(s) for CORS
# Comma-separated list of allowed frontend domains.
# Only these exact origins will be permitted to access the API in production.
FRONTEND_URL=https://mydomain.com,https://www.mydomain.com

# Optional: Razorpay Payment Gateway Keys (if online payments are active)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Coupon Reservation Timeout in minutes (default: 15)
COUPON_RESERVATION_TIMEOUT_MINUTES=15
