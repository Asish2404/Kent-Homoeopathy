# ==============================================================================
# Frontend Environment Configuration (React / Vite)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env in local development: cp .env.example .env
# 2. In production, configure this variable in your CI/CD or build environment before running `npm run build`.
# ==============================================================================

# Backend API Base URL
# In production on Hostinger: Points to your backend API subdomain (e.g., https://api.mydomain.com)
# In local development: http://localhost:4000
VITE_API_URL=https://api.mydomain.com

# Optional: Razorpay Key ID for payments (Public Key only - safe for client-side)
# VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
